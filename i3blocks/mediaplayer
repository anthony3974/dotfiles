#!/bin/bash

# Handle mouse clicks
case $BLOCK_BUTTON in
    2) playerctl play-pause ;; # Left click
    5) playerctl next ;;       # Scroll up
    4) playerctl previous ;;   # Scroll down
esac

# Check status
status=$(playerctl status 2>/dev/null)

if [ "$status" = "Playing" ]; then
    icon="▶"
elif [ "$status" = "Paused" ]; then
    icon="⏸"
else
    exit 0
fi

# Fetch metadata in one call and escape Pango entities (&, <, >)
text=$(playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')

if [ -n "$text" ]; then
    # Print icon and truncated text safely using printf
    printf "%s %-.35s\n" "$icon" "$text"
fi
