# ~/.bashrc

# If not running interactively, don't do anything
[[ $- != *i* ]] && return
# put anything after the next line !!!

run_debug_hook() {
    echo -ne "\e[0m" # Resets color back to default/white before command runs
}

trap 'run_debug_hook' DEBUG

# --- bash history configuration ---

# [ignoreboth:erasedups] 'ignoreboth' combines 'ignorespace' (commands starting with a leading space)
# and 'ignoredups' (skips consecutive duplicate commands).
# 'erasedups' deletes all previous identical entries from the entire history list.
HISTCONTROL=ignoreboth:erasedups

# [50000] Number of commands kept in active memory (RAM) for the current session (searched by Up Arrow / Ctrl+R)
HISTSIZE=50000

# [100000] Maximum lines saved to the physical ~/.bash_history file on disk before older lines are trimmed
HISTFILESIZE=100000

# [histappend] Appends new commands to ~/.bash_history on exit instead of overwriting the file
shopt -s histappend

# [cmdhist] 'Command history' vs 'line history': saves all lines of a multi-line command
# (loops, functions) into a single functional entry instead of breaking them into fragmented lines
shopt -s cmdhist

# Append the last command to disk immediately before showing the next prompt
PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }history -a"
# --- END: bash history configuration ---

# 'ls' aliases
alias ls='ls --color=auto'
alias ll='ls -lh'
alias la='ls -a'
alias li='ls -1N'
alias grep='grep --color=auto'

# 'PS1' prompt configuration
PS1='\[\e[1;36m\]\u\[\e[1;31m\]@\[\e[1;32m\]\h \[\e[1;33m\]\W\[\e[1;32m\]\$\[\e[0m\] '
# Standard / Dim (Foreground)
# 31: Red            \[\e[31m\]
# 32: Green          \[\e[32m\]
# 33: Yellow         \[\e[33m\]
# 34: Blue           \[\e[34m\]
# 35: Magenta        \[\e[35m\]
# 36: Cyan           \[\e[36m\]
# 37: White          \[\e[37m\]

# Bold / Bright (Foreground)
# 1;31: Bright Red                \[\e[1;31m\]  or  \[\e[91m\]
# 1;32: Bright Green              \[\e[1;32m\]  or  \[\e[92m\]
# 1;33: Bright Yellow             \[\e[1;33m\]  or  \[\e[93m\]
# 1;34: Bright Blue               \[\e[1;34m\]  or  \[\e[94m\]
# 1;35: Bright Magenta            \[\e[1;35m\]  or  \[\e[95m\]
# 1;36: Bright Cyan               \[\e[1;36m\]  or  \[\e[96m\]
# 1;37: Bright White              \[\e[1;37m\]  or  \[\e[97m\]

# Text Attributes / Reset
# 0:  Reset all attributes        \[\e[0m\]
# 1:  Bold/Bright                 \[\e[1m\]
# 2:  Dim/Faint                   \[\e[2m\]
# 4:  Underline                   \[\e[4m\]

