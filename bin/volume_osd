#!/bin/bash

INPUT="$1"

# Kill previous instances so repeated presses reset cleanly
killall -q -w -n 1 vol_osd 2>/dev/null
pkill -f "title=vol_osd" 2>/dev/null

# Get current volume first
CURRENT=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]\+%' | head -1 | tr -d '%')
: "${CURRENT:=0}"

# Only change volume if an argument was provided
if [ -n "$INPUT" ]; then
    if [[ "$INPUT" =~ ^[+-] ]]; then
        TARGET=$((CURRENT + INPUT))
    else
        TARGET=$INPUT
    fi

    # Clamp between 0 and 130
    [ "$TARGET" -gt 130 ] && TARGET=130
    [ "$TARGET" -lt 0 ] && TARGET=0

    pactl set-sink-volume @DEFAULT_SINK@ "${TARGET}%"
    VOL=$TARGET
else
    VOL=$CURRENT
fi

# Build bar: exactly 26 blocks (5% each = 130% total)
TOTAL_BLOCKS=26
ACTIVE_BLOCKS=$((VOL / 5))
[ "$ACTIVE_BLOCKS" -gt 26 ] && ACTIVE_BLOCKS=26

# Split into normal range (0-100%, 20 blocks) and boost range (105-130%, 6 blocks)
if [ "$ACTIVE_BLOCKS" -le 20 ]; then
    GREEN_COUNT=$ACTIVE_BLOCKS
    ORANGE_COUNT=0
    EMPTY_COUNT=$((TOTAL_BLOCKS - ACTIVE_BLOCKS))
else
    GREEN_COUNT=20
    ORANGE_COUNT=$((ACTIVE_BLOCKS - 20))
    EMPTY_COUNT=$((TOTAL_BLOCKS - ACTIVE_BLOCKS))
fi

GREEN_BAR=""
[ "$GREEN_COUNT" -gt 0 ] && GREEN_BAR=$(printf "%0.s█" $(seq 1 $GREEN_COUNT))

ORANGE_BAR=""
[ "$ORANGE_COUNT" -gt 0 ] && ORANGE_BAR=$(printf "%0.s█" $(seq 1 $ORANGE_COUNT))

EMPTY_BAR=""
[ "$EMPTY_COUNT" -gt 0 ] && EMPTY_BAR=$(printf "%0.s█" $(seq 1 $EMPTY_COUNT))

# Color text to orange if boosted past 100%, otherwise lightgreen
TEXT_COLOR="lightgreen"
[ "$VOL" -gt 100 ] && TEXT_COLOR="#ff7700"

# --- DYNAMIC RESOLUTION & SCALING ---
# Extract Primary Monitor: Width, Height, Origin X, Origin Y
read MON_W MON_H ORIGX ORIGY <<< "$(xrandr --query | awk '/ primary/{split($4, a, "[+x]"); print a[1], a[2], a[3], a[4]}')"

# Fallbacks if primary flag is missing
: "${MON_W:=2560}"; : "${MON_H:=1440}"; : "${ORIGX:=0}"; : "${ORIGY:=0}"

# Scale font size, window width, and height by display height
if [ "$MON_H" -ge 2160 ]; then
    # 4K (2160p)
    FONT_SZ=32
    OSD_WIDTH=1150
    OSD_HEIGHT=64
elif [ "$MON_H" -le 1080 ]; then
    # 1080p
    FONT_SZ=16
    OSD_WIDTH=580
    OSD_HEIGHT=34
else
    # 1440p default
    FONT_SZ=22
    OSD_WIDTH=780
    OSD_HEIGHT=44
fi

BAR_MARKUP="<span size='${FONT_SZ}000' weight='bold' font_family='monospace' foreground='${TEXT_COLOR}'>$(printf "%3d%% " "$VOL")</span><span size='${FONT_SZ}000' foreground='lightgreen'>${GREEN_BAR}</span><span size='${FONT_SZ}000' foreground='#ff7700'>${ORANGE_BAR}</span><span size='${FONT_SZ}000' foreground='#2a2a2a'>${EMPTY_BAR}</span>"

# Dynamic Centering:
# Horizontal center: (Monitor Width - OSD Width) / 2
POSX=$(( ORIGX + (MON_W - OSD_WIDTH) / 2 ))

# Vertical: ~78% down the screen regardless of resolution
POSY=$(( ORIGY + (MON_H * 78 / 100) ))

# Show OSD
yad --text="$BAR_MARKUP" \
    --undecorated \
    --no-buttons \
    --skip-taskbar \
    --on-top \
    --no-focus \
    --width="$OSD_WIDTH" \
    --height="$OSD_HEIGHT" \
    --posx="$POSX" --posy="$POSY" \
    --timeout=1 \
    --title="vol_osd" \
    --fixed \
    >/dev/null 2>&1 &

YAD_PID=$!

# Force window above fullscreen via override-redirect without losing input
(
    for _ in {1..20}; do
        WID=$(xdotool search --pid "$YAD_PID" --onlyvisible 2>/dev/null | tail -n 1)
        [ -n "$WID" ] && break
        sleep 0.01
    done

    if [ -n "$WID" ]; then
        xdotool windowunmap "$WID"
        xdotool set_window --overrideredirect 1 "$WID"
        xdotool windowmap "$WID"
        xdotool windowraise "$WID"
    fi
) &
