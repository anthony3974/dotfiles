#!/bin/bash

INPUT="$1"

# Kill previous instances so repeated presses reset cleanly
killall -q -w -n 1 vol_osd 2>/dev/null
pkill -f "title=vol_osd" 2>/dev/null

# Get current volume first
CURRENT=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]\+%' | head -1 | tr -d '%')
: "${CURRENT:=0}"

# Only change volume if an argument was provided
if [ -n "$INPUT" ]; then
    if [[ "$INPUT" =~ ^[+-] ]]; then
        TARGET=$((CURRENT + INPUT))
    else
        TARGET=$INPUT
    fi

    # Clamp between 0 and 130
    [ "$TARGET" -gt 130 ] && TARGET=130
    [ "$TARGET" -lt 0 ] && TARGET=0

    pactl set-sink-volume @DEFAULT_SINK@ "${TARGET}%"
    VOL=$TARGET
else
    VOL=$CURRENT
fi

# Build bar: exactly 26 blocks (5% each = 130% total)
TOTAL_BLOCKS=26
ACTIVE_BLOCKS=$((VOL / 5))
[ "$ACTIVE_BLOCKS" -gt 26 ] && ACTIVE_BLOCKS=26

# Split into normal range (0-100%, up to 20 blocks) and boost range (105-130%, up to 6 blocks)
if [ "$ACTIVE_BLOCKS" -le 20 ]; then
    GREEN_COUNT=$ACTIVE_BLOCKS
    ORANGE_COUNT=0
    EMPTY_COUNT=$((TOTAL_BLOCKS - ACTIVE_BLOCKS))
else
    GREEN_COUNT=20
    ORANGE_COUNT=$((ACTIVE_BLOCKS - 20))
    EMPTY_COUNT=$((TOTAL_BLOCKS - ACTIVE_BLOCKS))
fi

GREEN_BAR=""
[ "$GREEN_COUNT" -gt 0 ] && GREEN_BAR=$(printf "%0.s█" $(seq 1 $GREEN_COUNT))

ORANGE_BAR=""
[ "$ORANGE_COUNT" -gt 0 ] && ORANGE_BAR=$(printf "%0.s█" $(seq 1 $ORANGE_COUNT))

EMPTY_BAR=""
[ "$EMPTY_COUNT" -gt 0 ] && EMPTY_BAR=$(printf "%0.s█" $(seq 1 $EMPTY_COUNT))

BAR_MARKUP="<span font='22' foreground='lightgreen'>${GREEN_BAR}</span><span font='22' foreground='#ff7700'>${ORANGE_BAR}</span><span font='22' foreground='#2a2a2a'>${EMPTY_BAR}</span>"

# Get primary monitor origin with fallback
if [ -x "$HOME/.local/bin/get_primary_origin.sh" ]; then
    read ORIGX ORIGY <<< "$("$HOME/.local/bin/get_primary_origin.sh")"
else
    ORIGX=0
    ORIGY=0
fi
: "${ORIGX:=0}"; : "${ORIGY:=0}"

# Centering for 1440p (2560 - 680) / 2 = 940
POSX=$((ORIGX + 940))
POSY=$((ORIGY + 1100))

# Show OSD (added --no-focus)
yad --text="$BAR_MARKUP" \
    --undecorated \
    --no-buttons \
    --skip-taskbar \
    --on-top \
    --no-focus \
    --width=680 \
    --height=40 \
    --posx="$POSX" --posy="$POSY" \
    --timeout=1 \
    --title="vol_osd" \
    --fixed \
    >/dev/null 2>&1 &

YAD_PID=$!

# Force window above fullscreen via override-redirect without losing game input
(
    for _ in {1..20}; do
        WID=$(xdotool search --pid "$YAD_PID" --onlyvisible 2>/dev/null | tail -n 1)
        [ -n "$WID" ] && break
        sleep 0.01
    done

    if [ -n "$WID" ]; then
        # Unmap, set override_redirect, remap, and raise
        xdotool windowunmap "$WID"
        xdotool set_window --overrideredirect 1 "$WID"
        xdotool windowmap "$WID"
        xdotool windowraise "$WID"
    fi
) &
