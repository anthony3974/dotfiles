#!/bin/bash

INPUT="$1"

# Kill previous instances so repeated presses reset cleanly
killall -q -w -n 1 vol_osd 2>/dev/null
pkill -f "title=vol_osd" 2>/dev/null

# Get current volume first
CURRENT=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]\+%' | head -1 | tr -d '%')

# Only change volume if an argument was provided
if [ -n "$INPUT" ]; then
    if [[ "$INPUT" =~ ^[+-] ]]; then
        TARGET=$((CURRENT + INPUT))
    else
        TARGET=$INPUT
    fi

    # Clamp between 0 and 100
    if [ "$TARGET" -gt 100 ]; then TARGET=100; fi
    if [ "$TARGET" -lt 0 ]; then TARGET=0; fi

    pactl set-sink-volume @DEFAULT_SINK@ "${TARGET}%"
    VOL=$TARGET
else
    VOL=$CURRENT
fi

# Build bar: each block = 5%
BLOCKS=$((VOL / 5))
if [ "$BLOCKS" -gt 0 ]; then
    BAR=$(printf "%0.s█" $(seq 1 $BLOCKS))
else
    BAR=""
fi

# Get primary monitor origin
read ORIGX ORIGY <<< "$(~/.local/bin/get_primary_origin.sh)"
: "${ORIGX:=0}"; : "${ORIGY:=0}"

# Horizontal centering on 1440p (2560 wide - 465 wide / 2 = 1047)
POSX=$((ORIGX + 1047))
POSY=$((ORIGY + 1100))

# Show OSD
yad --text="<span font='22' foreground='lightgreen'>$BAR</span>" \
    --undecorated \
    --no-buttons \
    --skip-taskbar \
    --on-top \
    --width=465 \
    --height=40 \
    --posx="$POSX" --posy="$POSY" \
    --timeout=1 \
    --title="vol_osd" \
    --fixed \
    >/dev/null 2>&1 &

YAD_PID=$!

# Force window above fullscreen via override-redirect
(
    for _ in {1..20}; do
        WID=$(xdotool search --pid "$YAD_PID" --onlyvisible 2>/dev/null | tail -n 1)
        [ -n "$WID" ] && break
        sleep 0.01
    done

    if [ -n "$WID" ]; then
        xdotool set_window --overrideredirect 1 "$WID"
        xdotool windowraise "$WID"
    fi
) &
