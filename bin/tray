#!/usr/bin/env python3
import os
# i3bar only shows XEmbed icons; with libappindicator installed pystray would pick the
# appindicator (SNI) backend and the icon would be invisible. Force the GTK/XEmbed backend.
os.environ.setdefault('PYSTRAY_BACKEND', 'gtk')
import pystray, subprocess, time, threading
from PIL import Image, ImageDraw

# version 2.5 refresh pause checkbox on click, on file change, and on expiry
# version 2.4.1 reordered menuitems for order
# version 2.4 added xsct pause for 1 hour with auto-expiration
# version 2.3 updated display scripts to res-*

HOME = os.path.expanduser('~')
TOGGLE_FILE = os.path.join(HOME, '.xsct.file')

# 1. Define all commands here. Easy to read, easy to edit.
COMMANDS = {
    "xsct 5500 (Day)": "xsct 5500",
    "xsct 5000 0.9 (Dayy)": "xsct 5000 0.9",
    "xsct 4000 0.7 (Day Dark)": "xsct 4000 0.7",
    "xsct 3000 (Evening)": "xsct 3000",
    "xsct 2200 0.7 (Night)": "xsct 2200 0.7",
    "Res 4K 165Hz": f"bash {HOME}/.local/bin/res-4k-165",
    "Res 4K 120Hz": f"bash {HOME}/.local/bin/res-4k-120",
    "Res 4K 60Hz": f"bash {HOME}/.local/bin/res-4k-60",
    "Res 1440p 165Hz": f"bash {HOME}/.local/bin/res-1440-165",
    "Res 1080p 360Hz": f"bash {HOME}/.local/bin/res-1080-360",
    "Res 1080p 60Hz": f"bash {HOME}/.local/bin/res-1080-60",
}

def run(cmd):
    # start_new_session prevents child scripts from freezing the tray applet
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

def is_paused(item=None):
    if not os.path.exists(TOGGLE_FILE):
        return False
    try:
        with open(TOGGLE_FILE, 'r') as f:
            content = f.read().strip()
        if content == '0':
            return False
        if content in ('hold', 'forever'):
            return True
        now = time.time()
        if content.isdigit() and len(content) >= 10:
            if int(content) <= now:
                try:
                    os.remove(TOGGLE_FILE)
                except OSError:
                    pass
                return False
            return True
        mtime = os.path.getmtime(TOGGLE_FILE)
        if now - mtime >= 3600:
            try:
                os.remove(TOGGLE_FILE)
            except OSError:
                pass
            return False
        return True
    except Exception:
        return False

def pause_1hour():
    try:
        with open(TOGGLE_FILE, 'w') as f:
            f.write(str(int(time.time() + 3600)))
    except Exception:
        pass

def toggle_pause():
    if is_paused():
        try:
            if os.path.exists(TOGGLE_FILE):
                os.remove(TOGGLE_FILE)
        except OSError:
            pass
        run(f"bash {HOME}/.local/bin/nightlight resume")
    else:
        pause_1hour()

def click(i, item):
    name = str(item)
    # 2. Logic automatically looks up the command in the dictionary
    if name in COMMANDS:
        run(COMMANDS[name])
        # Auto-pause nightlight for 1 hour when an xsct preset is clicked
        if name.startswith("xsct"):
            pause_1hour()
    elif name in ("Pause Nightlight (1h)", "Toggle xsct File"):
        toggle_pause()
    elif name == "Quit":
        i.stop()
        return
    refresh(i)

def refresh(i, item=None):
    # appindicator/gtk build the menu once; force checked= to be re-evaluated
    i.update_menu()

def watch(i):
    # Keep the checkbox in sync with ~/.xsct.file (expiry, `nightlight pause/resume`)
    i.visible = True
    last = None
    while True:
        state = is_paused()
        if state != last:
            last = state
            refresh(i)
        time.sleep(2)

# Generate icon
img = Image.new('RGB', (64, 64), color='white')
ImageDraw.Draw(img).rectangle([14, 14, 52, 52], fill='black')
ImageDraw.Draw(img).rectangle([24, 24, 40, 40], fill='red')

# 3. Dynamically build the menu from the dictionary
# Hidden default item: left-clicking the icon refreshes the menu state
menu_items = [pystray.MenuItem("Refresh", refresh, default=True, visible=False)]
menu_items += [pystray.MenuItem(name, click) for name in COMMANDS.keys()]
menu_items.extend([
    pystray.MenuItem("Pause Nightlight (1h)", click, checked=is_paused),
    pystray.MenuItem("Quit", click)
])

pystray.Icon("Control", img, menu=pystray.Menu(*menu_items)).run(
    setup=lambda i: threading.Thread(target=watch, args=(i,), daemon=True).start())
