#!/usr/bin/env python3
import pystray, subprocess, os
from PIL import Image, ImageDraw

# version 2.3 # version 2.2 added more xsct persets
# version 2.1 - caffine removed

HOME = os.path.expanduser('~')
TOGGLE_FILE = os.path.join(HOME, '.xsct.file')

# 1. Define all commands here. Easy to read, easy to edit.
COMMANDS = {
    "xsct 5500 (Day)": "xsct 5500",
    "xsct 5000 0.9 (Dayy)": "xsct 5000 0.9",
    "xsct 3000 (Evening)": "xsct 3000",
    "xsct 2200 0.7 (Night)": "xsct 2200 0.7",
    "xsct 4000 0.7 (Day Dark)": "xsct 4000 0.7",
    "Run xrandr Scale": f"bash {HOME}/.local/bin/dispayscale",
    "Run xrandr 4K": f"bash {HOME}/.local/bin/dispay4k",
    "Run xrandr Reset": f"bash {HOME}/.local/bin/dispay",
    "Run xrandr Dup": f"bash {HOME}/.local/bin/dispaydup",
    "Run xrandr 1080": f"bash {HOME}/.local/bin/dispay1080",
    "Run xrandr Right": f"bash {HOME}/.local/bin/dispayright",
}

def run(cmd):
    # start_new_session prevents child scripts from freezing the tray applet
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

def toggle_file():
    if os.path.exists(TOGGLE_FILE):
        os.remove(TOGGLE_FILE)
    else:
        open(TOGGLE_FILE, 'w').close()

def is_toggled(item):
    return os.path.exists(TOGGLE_FILE)

def click(i, item):
    name = str(item)
    # 2. Logic automatically looks up the command in the dictionary
    if name in COMMANDS:
        run(COMMANDS[name])
    elif name == "Toggle xsct File":
        toggle_file()
    elif name == "Quit":
        i.stop()

# Generate icon
img = Image.new('RGB', (64, 64), color='white')
ImageDraw.Draw(img).rectangle([14, 14, 52, 52], fill='black')
ImageDraw.Draw(img).rectangle([24, 24, 40, 40], fill='red')

# 3. Dynamically build the menu from the dictionary
menu_items = [pystray.MenuItem(name, click) for name in COMMANDS.keys()]
menu_items.extend([
    pystray.MenuItem("Toggle xsct File", click, checked=is_toggled),
    pystray.MenuItem("Quit", click)
])

pystray.Icon("Control", img, menu=pystray.Menu(*menu_items)).run()
