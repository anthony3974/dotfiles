#!/bin/sh
# Keep the screen awake while prismlauncher runs, by holding caffeine on (see
# caffeine-applet). The applet drops the hold once this process is gone, so a crash
# or shutdown can't leave caffeine stuck on.
hold="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/caffeine/$$"
mkdir -p "${hold%/*}"
echo prismlauncher > "$hold"
trap 'rm -f "$hold"' EXIT
trap 'exit 1' INT TERM HUP

# Enable GGTU only when the display is running at 4K
MODS="$HOME/.local/share/PrismLauncher/instances/26.3/minecraft/mods"
res=$(xrandr --current | awk '/\*/ {print $1; exit}')
width=${res%%x*}
if [ "${width:-0}" -ge 3840 ]; then
  for f in "$MODS"/*GGTU*.jar.disabled; do
    [ -e "$f" ] && mv "$f" "${f%.disabled}"
  done
else
  for f in "$MODS"/*GGTU*.jar; do
    [ -e "$f" ] && mv "$f" "$f.disabled"
  done
fi

prismlauncher "$@"
